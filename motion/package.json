{
  "name": "teslinha-commercial",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "typecheck": "tsc --noEmit",
    "validate": "npm run test && npm run test:narration-cache && npm run typecheck",
    "audio": "tsx scripts/generate-audio.ts",
    "stills": "tsx scripts/render.ts stills",
    "render": "tsx scripts/render.ts video",
    "preview": "tsx scripts/render.ts preview",
    "verify": "tsx scripts/verify.ts",
    "narration": "tsx scripts/build-narration.ts",
    "test:narration-cache": "python3 -m unittest discover -s tests -p 'test_narration_synthesis.py'",
    "music": "tsx scripts/generate-music.ts"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@remotion/bundler": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@remotion/transitions": "4.0.538",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
